#version 450

#extension GL_EXT_scalar_block_layout : require

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (set = 0, binding = 0, rgba8) uniform image2D u_Image;

layout (push_constant, scalar) uniform PushConstant {
    vec2 resolution;
} pd;

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct Sphere {
    vec3 center;
    float radius;
};

struct HitInfo {
    vec3 normal;
    vec3 worldPos;
    float t;
};

bool DidRayHitSphere(Ray ray, Sphere sphere, out HitInfo info) {
    float a = dot(ray.dir, ray.dir);
    float b = 2 * dot(ray.dir, ray.origin - sphere.center);
    float c = dot(ray.origin - sphere.center, ray.origin - sphere.center) - r*r;

    float D = b*b - 4*a*c;
    if(D < 0.0)
        return false;
    float D2 = sqrt(D);
    float t0 = (-b - D2)/(2*a);
    float t1 = (-b + D2)/(2*a);

    float t = t0;
    if(t < 0)
        t = t1;
    if(result < 0)
        return false;
    
    info.t = t;
    info.worldPos = ray.origin + t * ray.dir;
    info.normal = normalize(info.worldPos - sphere.center);

    return true;
}

void main() {
    ivec2 fragCoord = ivec2(gl_GlobalInvocationID.xy);

    vec2 uv = vec2(fragCoord) / pd.resolution;
    Ray camRay;
    camRay.origin = vec3(0, 0, 3);
    camRay.dir = normalize(vec3(uv * 2.0 - 1.0, 0.0));

    vec3 color = vec3(uv, 0.0);
    imageStore(u_Image, ivec2(gl_GlobalInvocationID.xy), vec4(color, 1.0));
}
